# t1: p2 trimmed to this phone (Exynos 7870 SM-G610F) and its role (small server, containers).
# j7-trim: lsmod=lsmod.j7p2 drop=t1.drop
# Build: base config + this fragment, then t1.drop (best effort), then localmodconfig against
# lsmod.j7p2 (modules loaded on the phone), then this fragment again; every line below is asserted
# by scripts/check-config.sh. Values are the running j7p2 values (generated by the trim tool, see
# j7-tests/results/2026-11-17-config-trim.md); edit by hand freely, keep LOCALVERSION.
CONFIG_LOCALVERSION="-j7t1"
CONFIG_DEBUG_KERNEL=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_FQ=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NTFS3_FS=m
# --- p2 assertions not covered by a group below
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_PANIC_TIMEOUT=10
# CONFIG_BATTERY_S2MU005 is not set
# CONFIG_CHARGER_S2M is not set
# CONFIG_EXTCON_S2M is not set
# CONFIG_LEDS_S2M_RGB is not set
# CONFIG_LEDS_S2M_FLASH is not set
