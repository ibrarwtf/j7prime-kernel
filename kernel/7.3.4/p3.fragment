# p3: p2 (see p2.fragment) + idle power (patches/7.3.4/0020-0033): MCT broadcast timer,
# ISP/MFCMSCL power domains, cluster power-down of the non-boot cluster, SD card-detect GPIO.
# Each line must survive olddefconfig (scripts/check-config.sh).
CONFIG_LOCALVERSION="-j7p3"
# early pstore console + pmsg (ramoops built in, 256 KiB layout from the DT patch 0001)
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# our own modules must load: no forced lockdown, no forced signatures
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
CONFIG_PANIC_TIMEOUT=10
# patches/7.3.4/0002 + 0003
CONFIG_BATTERY_S2MU005_FG=m
CONFIG_KEYBOARD_MIP4_TOUCHKEY=m
# safety: no upstream S2MU005 function driver (charger, MUIC, LEDs, other FG).
# The S2MU005 MFD part lives in MFD_SEC_CORE/MFD_SEC_I2C, which must stay =y for
# the S2MPU05 PMIC; it only binds a "samsung,s2mu005-pmic" DT node, which our DT never has.
# CONFIG_BATTERY_S2MU005 is not set
# CONFIG_CHARGER_S2M is not set
# CONFIG_EXTCON_S2M is not set
# CONFIG_LEDS_S2M_RGB is not set
# CONFIG_LEDS_S2M_FLASH is not set
# p2 (asserted)
CONFIG_EXYNOS_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_EMULATION=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_PM_OPP=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_DT_IDLE_STATES=y
CONFIG_EXYNOS_PMU=y
CONFIG_COMMON_CLK_SAMSUNG=y
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_MFD_SEC_CORE=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_THERMAL_STATISTICS=y
# p3 (all already =y in config-stable.aarch64, verified on 7.3.4-j7p1's /proc/config.gz;
# asserted so the build fails if the base drops one)
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
# new vs the base: the TEO governor, selectable at run time
# (/sys/devices/system/cpu/cpuidle/current_governor) to compare with menu
CONFIG_CPU_IDLE_GOV_TEO=y
