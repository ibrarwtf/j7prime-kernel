+	/*
+	 * CPU operating points. Frequencies are the exact PLL rates of the
+	 * clk-cpu configuration table (anything else is rejected).
+	 *
+	 * Voltages: vendor ASV table 5 (group 5) plus 25 mV, as used for the
+	 * SM-T580 in Alessandro Fontana's tree. At every level they are at
+	 * or above the BUCK1 values measured under the vendor kernel on an
+	 * SM-J701F plus 12.5 mV (Burak), so no level is undervolted against
+	 * either reference. The ASV group of this chip is not known: compare
+	 * the boot voltage of BUCK1 (bootloader level 902.2 MHz) with the
+	 * 902.2 MHz entry before enabling cpufreq.
+	 *
+	 * The maximum is capped at 1248 MHz for the bring-up; 1352, 1482 and
+	 * 1586 MHz (the vendor maximum) are present but disabled. 1690 MHz
+	 * and above have no voltage in the vendor ASV table and are not
+	 * listed.
+	 *
+	 * Both clusters share BUCK1: the wide maximum in opp-microvolt lets
+	 * the regulator core keep the rail at the highest of the two
+	 * requests.
+	 */
+	cpucl0_opp_table: opp-table-cpucl0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-546000000 {
+			opp-hz = /bits/ 64 <546000000>;
+			opp-microvolt = <675000 675000 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-676000000 {
+			opp-hz = /bits/ 64 <676000000>;
+			opp-microvolt = <718750 718750 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-756600000 {
+			opp-hz = /bits/ 64 <756600000>;
+			opp-microvolt = <743750 743750 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-838500000 {
+			opp-hz = /bits/ 64 <838500000>;
+			opp-microvolt = <762500 762500 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-902200000 {
+			opp-hz = /bits/ 64 <902200000>;
+			opp-microvolt = <787500 787500 1300000>;
+			clock-latency-ns = <140000>;
+			opp-suspend;
+		};
+
+		opp-1014000000 {
+			opp-hz = /bits/ 64 <1014000000>;
+			opp-microvolt = <831250 831250 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-1144000000 {
+			opp-hz = /bits/ 64 <1144000000>;
+			opp-microvolt = <881250 881250 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-1248000000 {
+			opp-hz = /bits/ 64 <1248000000>;
+			opp-microvolt = <925000 925000 1300000>;
+			clock-latency-ns = <140000>;
+		};
+
+		opp-1352000000 {
+			opp-hz = /bits/ 64 <1352000000>;
+			opp-microvolt = <968750 968750 1300000>;
+			clock-latency-ns = <140000>;
+			status = "disabled";
+		};
+
+		opp-1482000000 {
+			opp-hz = /bits/ 64 <1482000000>;
+			opp-microvolt = <1018750 1018750 1300000>;
+			clock-latency-ns = <140000>;
+			status = "disabled";
+		};
+
+		opp-1586000000 {
+			opp-hz = /bits/ 64 <1586000000>;
+			opp-microvolt = <1068750 1068750 1300000>;
+			clock-latency-ns = <140000>;
+			status = "disabled";
+		};
+	};
+
+	cpucl1_opp_table: opp-table-cpucl1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-546000000 {
+			opp-hz = /bits/ 64 <546000000>;
+			opp-microvolt = <675000 675000 1300000>;
