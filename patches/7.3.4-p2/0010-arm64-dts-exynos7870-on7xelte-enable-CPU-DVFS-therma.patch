+	/*
+	 * One sensor for the whole SoC. Trips are below the vendor ones
+	 * (ECT AP_THERMAL: 76..101 C bands, hardware trip at 115 C), because
+	 * this phone runs as an always-on server in a closed case:
+	 *   80 C: both clusters to 902.2 MHz (the bootloader level),
+	 *   90 C: both clusters to 546 MHz (lowest enabled level),
+	 *  100 C: "hot" notification only,
+	 *  110 C: critical, orderly power-off.
+	 * CPU cooling states index the enabled OPPs from the top:
+	 * 0 = 1248, 3 = 902.2, 7 = 546 MHz.
+	 */
+	thermal-zones {
+		soc-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <2000>;
+			thermal-sensors = <&tmu>;
+
+			trips {
+				soc_alert0: soc-alert0 {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				soc_alert1: soc-alert1 {
+					temperature = <90000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				soc-hot {
+					temperature = <100000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				soc-crit {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&soc_alert0>;
+					cooling-device = <&cpu0 3 3>,
+							 <&cpu4 3 3>;
+				};
+
+				map1 {
+					trip = <&soc_alert1>;
+					cooling-device = <&cpu0 7 7>,
+							 <&cpu4 7 7>;
+				};
+			};
+		};
+	};
+
 	vibrator {
 		compatible = "regulator-haptic";
 		haptic-supply = <&vdd_ldo32>;
@@ -110,6 +362,54 @@
 	};
 };
 
