From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: j7prime p3 <p3@j7prime.invalid>
Date: Tue, 17 Nov 2026 01:00:00 +0530
Subject: [PATCH] arm64: dts: exynos7870: add the MFCMSCL power domain

Describe the MFCMSCL power domain (PMU 0x4060, vendor pd_mfcmscl) and
put CMU_MFCMSCL in it.

To skip on a test boot: pd_ignore_unused, or status = "disabled" on
the domain node (CMU_MFCMSCL then stays unregistered, like the clocks
of a block nobody uses).

Origin: new in j7prime p3, after the ISP domain node (5208351dde6f in github.com/a3y17lte-mainline/kernel_samsung_exynos7870 (branch lineage-24.0)).
Assisted-by: Claude Opus 5.5
---

Notes:
    New.

 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+), 0 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -305,6 +305,14 @@
 			label = "isp";
 		};
 
+		pd_mfcmscl: power-domain@10484060 {
+			compatible = "samsung,exynos7870-pd",
+				     "samsung,exynos5433-pd";
+			reg = <0x10484060 0x20>;
+			#power-domain-cells = <0>;
+			label = "mfcmscl";
+		};
+
 		gic: interrupt-controller@104e1000 {
 			compatible = "arm,cortex-a15-gic";
 			reg = <0x104e1000 0x1000>,
@@ -375,6 +383,7 @@
 			clocks = <&oscclk>,
 				 <&cmu_mif CLK_GOUT_MIF_CMU_MFCMSCL_MFC>,
 				 <&cmu_mif CLK_GOUT_MIF_CMU_MFCMSCL_MSCL>;
+			power-domains = <&pd_mfcmscl>;
 		};
 
 		mmc0: mmc@13540000 {
-- 
2.47.0
