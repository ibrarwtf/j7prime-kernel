From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: j7prime p3 <p3@j7prime.invalid>
Date: Tue, 17 Nov 2026 01:00:00 +0530
Subject: [PATCH] soc: samsung: exynos7870-pmu: add cluster power-down

The Exynos7870 PSCI firmware handles a cluster power state (affinity
level 1) only when the calling CPU is the last powered CPU of its
cluster: it then flushes L2 and takes the cluster out of coherency.
From any other CPU it returns at once without powering anything down.
It also leaves the PMU CPU sequencer of the cluster alone in
CPU_SUSPEND (it only enables it for CPU_OFF), and without the sequencer
the cluster stays powered.

Do the coordination in the kernel, as the vendor kernel does. Grant a
cluster request only when all other online CPUs of the cluster are in a
power-down state and none of them is due to wake up within 3 ms, the
vendor's cluster residency; otherwise request the core state instead.
Enable the sequencer (CPUCL1_CPUSEQUENCER_OPTION, 0x24a8) from the CPU
PM notifier for a granted request and disable it on every exit.

Only the non-boot cluster is handled: the boot cluster holds the CPUCL0
watchdog, and the vendor kernel never powers it down either. Nothing
changes unless a cluster idle state exists in the DT and is enabled.

Origin: Martin Štrobl, github.com/a3y17lte-mainline/kernel_samsung_exynos7870 (branch lineage-24.0) commit 804477225eb6,
moved into the Exynos7870 PMU file of 0011 (Fontana's notifier) instead of exynos-pmu.c.
Assisted-by: Claude Opus 5.5
---

Notes:
    Port to v7.3.4 + j7prime 0001-0017: same logic; registered from exynos7870_pmu_init() and using
    pmu_raw_readl/writel; per_cpu(cpuidle_devices) guarded by CONFIG_CPU_IDLE.

 drivers/soc/samsung/exynos7870-pmu.c | 138 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 137 insertions(+), 1 deletions(-)

diff --git a/drivers/soc/samsung/exynos7870-pmu.c b/drivers/soc/samsung/exynos7870-pmu.c
--- a/drivers/soc/samsung/exynos7870-pmu.c
+++ b/drivers/soc/samsung/exynos7870-pmu.c
@@ -20,10 +20,19 @@
 
 #include <linux/bits.h>
 #include <linux/cpu_pm.h>
+#include <linux/cpuidle.h>
+#include <linux/cpumask.h>
+#include <linux/ktime.h>
 #include <linux/notifier.h>
+#include <linux/percpu.h>
+#include <linux/psci.h>
 #include <linux/soc/samsung/exynos-pmu.h>
+#include <linux/spinlock.h>
 
 #include <asm/cputype.h>
+#include <asm/smp_plat.h>
+
+#include <uapi/linux/psci.h>
 
 #include "exynos-pmu.h"
 
@@ -32,18 +41,136 @@
 		    MPIDR_AFFINITY_LEVEL(mpidr, 0)) * 0x80))
 #define EXYNOS7870_CPU_LOCAL_PWR_CFG	GENMASK(3, 0)
 
+/*
+ * Cluster power-down. The firmware accepts a PSCI cluster power state only
+ * from the last powered CPU of the cluster: it then flushes L2 and takes the
+ * cluster out of coherency. From any other CPU it returns at once without
+ * powering anything down. The cluster is only powered off if the CPU
+ * sequencer of the cluster is enabled when its last core goes down, which the
+ * firmware does for CPU_OFF but leaves to the kernel for CPU_SUSPEND.
+ *
+ * A request for the cluster state is therefore downgraded to the core state
+ * unless all other online CPUs of the cluster are in a power-down state and
+ * none of them is due to wake up within the cluster target residency. The
+ * sequencer must never be left enabled when the last core enters a core-only
+ * state, since L2 would then be powered off without being flushed: every
+ * power-down entry of a CPU in the cluster sets it to whether this entry is a
+ * granted cluster request, and every exit disables it. Only the non-boot
+ * cluster is handled: the boot cluster holds the CPUCL0 watchdog, and the
+ * vendor kernel never powers it down either.
+ *
+ * Nothing here runs unless a cluster idle state is described in the DT for
+ * CPUs of cluster 1 and enabled at run time.
+ */
+#define EXYNOS7870_CPUCL1_CPUSEQUENCER_OPTION	0x24a8
+#define EXYNOS7870_CPUSEQUENCER_EN		BIT(0)
+#define EXYNOS7870_CLUSTER_PD_RESIDENCY_NS	(3 * NSEC_PER_MSEC)
+
+static DEFINE_RAW_SPINLOCK(exynos7870_cluster_lock);
+static struct cpumask exynos7870_cluster_cpus;
+static struct cpumask exynos7870_cluster_down;
+static DEFINE_PER_CPU(bool, exynos7870_cluster_request);
+
+static void exynos7870_cluster_seq_set(bool enable)
+{
+	u32 val = pmu_raw_readl(EXYNOS7870_CPUCL1_CPUSEQUENCER_OPTION);
+
+	if (enable)
+		val |= EXYNOS7870_CPUSEQUENCER_EN;
+	else
+		val &= ~EXYNOS7870_CPUSEQUENCER_EN;
+	pmu_raw_writel(val, EXYNOS7870_CPUCL1_CPUSEQUENCER_OPTION);
+}
+
+static bool exynos7870_cluster_can_power_down(unsigned int cpu)
+{
+	ktime_t limit = 0;
+	unsigned int other;
+
+	for_each_cpu_and(other, &exynos7870_cluster_cpus, cpu_online_mask) {
+		struct cpuidle_device *dev;
+		ktime_t next;
+
+		if (other == cpu)
+			continue;
+		if (!cpumask_test_cpu(other, &exynos7870_cluster_down))
+			return false;
+
+		/*
+		 * Zero when not in cpuidle_enter(), e.g. in s2idle. Only read
+		 * the clock when there is a timer to check.
+		 */
+#ifdef CONFIG_CPU_IDLE
+		dev = per_cpu(cpuidle_devices, other);
+#else
+		dev = NULL;
+#endif
+		next = dev ? READ_ONCE(dev->next_hrtimer) : 0;
+		if (!next)
+			continue;
+		if (!limit)
+			limit = ktime_add_ns(ktime_get(),
+					     EXYNOS7870_CLUSTER_PD_RESIDENCY_NS);
+		if (ktime_before(next, limit))
+			return false;
+	}
+
+	return true;
+}
+
+static u32 exynos7870_cluster_state_fixup(u32 state)
+{
+	unsigned int cpu = smp_processor_id();
+	bool granted = false;
+
+	if (!(state & PSCI_0_2_POWER_STATE_AFFL_MASK))
+		return state;
+
+	if (cpumask_test_cpu(cpu, &exynos7870_cluster_cpus)) {
+		raw_spin_lock(&exynos7870_cluster_lock);
+		granted = exynos7870_cluster_can_power_down(cpu);
+		__this_cpu_write(exynos7870_cluster_request, granted);
+		raw_spin_unlock(&exynos7870_cluster_lock);
+	}
+
+	return granted ? state : state & ~PSCI_0_2_POWER_STATE_AFFL_MASK;
+}
+
+static void exynos7870_cluster_pm_enter(unsigned int cpu)
+{
+	raw_spin_lock(&exynos7870_cluster_lock);
+	cpumask_set_cpu(cpu, &exynos7870_cluster_down);
+	exynos7870_cluster_seq_set(__this_cpu_read(exynos7870_cluster_request));
+	raw_spin_unlock(&exynos7870_cluster_lock);
+}
+
+static void exynos7870_cluster_pm_exit(unsigned int cpu)
+{
+	raw_spin_lock(&exynos7870_cluster_lock);
+	cpumask_clear_cpu(cpu, &exynos7870_cluster_down);
+	__this_cpu_write(exynos7870_cluster_request, false);
+	exynos7870_cluster_seq_set(false);
+	raw_spin_unlock(&exynos7870_cluster_lock);
+}
+
 static int exynos7870_cpu_pm_notify(struct notifier_block *nb,
 				    unsigned long action, void *data)
 {
 	u32 offset = EXYNOS7870_CPU_CONFIGURATION(read_cpuid_mpidr());
 	u32 val = pmu_raw_readl(offset);
+	unsigned int cpu = smp_processor_id();
+	bool cluster = cpumask_test_cpu(cpu, &exynos7870_cluster_cpus);
 
 	switch (action) {
 	case CPU_PM_ENTER:
 		pmu_raw_writel(val & ~EXYNOS7870_CPU_LOCAL_PWR_CFG, offset);
+		if (cluster)
+			exynos7870_cluster_pm_enter(cpu);
 		break;
 	case CPU_PM_ENTER_FAILED:
 	case CPU_PM_EXIT:
+		if (cluster)
+			exynos7870_cluster_pm_exit(cpu);
 		if ((val & EXYNOS7870_CPU_LOCAL_PWR_CFG) !=
 		    EXYNOS7870_CPU_LOCAL_PWR_CFG)
 			pmu_raw_writel(val | EXYNOS7870_CPU_LOCAL_PWR_CFG,
@@ -60,7 +187,16 @@
 
 static void exynos7870_pmu_init(void)
 {
-	cpu_pm_register_notifier(&exynos7870_cpu_pm_nb);
+	unsigned int cpu;
+
+	for_each_possible_cpu(cpu)
+		if (MPIDR_AFFINITY_LEVEL(cpu_logical_map(cpu), 1) == 1)
+			cpumask_set_cpu(cpu, &exynos7870_cluster_cpus);
+
+	if (cpu_pm_register_notifier(&exynos7870_cpu_pm_nb))
+		return;
+
+	psci_cpuidle_set_state_fixup(exynos7870_cluster_state_fixup);
 }
 
 const struct exynos_pmu_data exynos7870_pmu_data = {
-- 
2.47.0
